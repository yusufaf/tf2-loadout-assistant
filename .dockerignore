# Allowlist: the build context is exactly what the Dockerfile COPYs, so a new
# directory (cdk/node_modules, .claude/, ...) can't silently ride along into
# every build. Add a `!` line when the Dockerfile starts COPYing something new.
*
!Dockerfile
!pyproject.toml
!uv.lock
!README.md
!src
!.cache
!frontend
frontend/node_modules
frontend/dist
# Vite would load these into `pnpm build` and inline any VITE_* value into the
# public bundle.
frontend/.env*
# A runtime cache; prod starts it empty (see Dockerfile).
.cache/lore
**/__pycache__
**/*.py[cod]
