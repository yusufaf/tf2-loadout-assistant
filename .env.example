# Steam Web API key — for the Valve item schema (IEconItems_440/GetSchema).
# Get one at https://steamcommunity.com/dev/apikey
STEAM_API_KEY=

# backpack.tf API key — for IGetPrices pricing data.
# Get one at https://backpack.tf/developer/apikey/view
BACKPACK_TF_API_KEY=

# The chat advisor takes no server-side LLM key. Each player pastes their own
# provider key into the browser and it travels with every /chat request; the
# server builds a model for that one turn and forgets the key. The provider list
# (anthropic / openai / openrouter, one fixed model each) lives in config.PROVIDERS.

# Cap on model requests per chat turn, so a runaway tool loop can't burn a key.
# A plain loadout turn uses about 8, a lore-checked style question about 13.
LLM_MAX_REQUESTS=25

# Live tests only (`uv run pytest --live`): the key tests/test_agent_live.py sends,
# exactly the way a browser would. The running app never reads these.
LLM_PROVIDER=anthropic
LLM_API_KEY=

# Steam sign-in. Both must be set to enable it -- leave blank to run signed-out.
# PUBLIC_BASE_URL is the realm/return_to base Steam redirects back to; must match
# exactly what you registered, no trailing slash.
#   dev:  http://localhost:5173
#   prod: https://tf2.yusufaf.dev
PUBLIC_BASE_URL=
# Random secret that signs the session cookie. Rotating it signs everyone out.
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SESSION_SECRET=

# Saved loadouts on the signed-in player's Steam account (DynamoDB). Leave
# DYNAMODB_TABLE_NAME blank to run without it -- the frontend keeps using its
# localStorage-only path, same optional-service story as chat/auth above.
# AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY are boto3's own native var names, not
# app-specific ones -- boto3 reads them (or ~/.aws/credentials) itself.
DYNAMODB_TABLE_NAME=
AWS_REGION=us-west-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
